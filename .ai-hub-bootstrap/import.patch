-          s3 CHANGELOG.md "s3://$BUCKET/app/$version/changelog.md" --cache-control "public, max-age=31536000, immutable" --content-type text/markdown
-          s3 dist/manifest.json "s3://$BUCKET/app/latest.json" --cache-control "no-cache" --content-type application/json
-          # 0.1.0/0.1.1 set to the preview channel still ask here.
-          s3 dist/manifest.json "s3://$BUCKET/app/preview/latest.json" --cache-control "no-cache" --content-type application/json
-          s3 distribution/install.sh "s3://$BUCKET/app/install.sh" --cache-control "no-cache" --content-type text/x-shellscript
-          s3 distribution/install.ps1 "s3://$BUCKET/app/install.ps1" --cache-control "no-cache" --content-type text/plain
+          # Stage assets in a draft first, so the update feed never sees a
+          # partially uploaded release. Re-running a published tag is a no-op.
+          if state=$(gh release view "$GITHUB_REF_NAME" --repo "$GITHUB_REPOSITORY" --json isDraft --jq .isDraft 2>/dev/null); then
+            if [[ "$state" == false ]]; then
+              echo "Release $GITHUB_REF_NAME is already published; preserving its assets."
+              exit 0
+            fi
+            gh release upload "$GITHUB_REF_NAME" dist/* --repo "$GITHUB_REPOSITORY" --clobber
+          else
+            gh release create "$GITHUB_REF_NAME" dist/* --repo "$GITHUB_REPOSITORY" --verify-tag --draft --title "AI Hub $GITHUB_REF_NAME" --generate-notes
+          fi
+          # Fork revision suffixes are intentional stable app versions. Keep
+          # releases/latest/download usable instead of inferring prerelease.
+          gh release edit "$GITHUB_REF_NAME" --repo "$GITHUB_REPOSITORY" --draft=false --prerelease=false --latest
